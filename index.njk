---
layout: base.njk
title: Home
---
<div class="hero-unit">
  <h1>kadencabs</h1>
  <p>Research notes and other stuff.</p>
</div>
<h2>Posts</h2>
{% for post in collections.posts | reverse %}
<div class="well">
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p class="muted">{{ post.date.toISOString().slice(0,10) }}</p>
</div>
{% endfor %}
